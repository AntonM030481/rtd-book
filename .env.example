# Copy to .env if it does not exist. Never commit real credentials.
# Start with npm start. Exit and launch again after editing .env;
# the restart/r console command does not reload these settings.
# Quote values containing # or spaces. Dates and times refer to Cyprus.

# Your existing RTD account username. Required for automatic login.
RTD_USER=""

# Your RTD account password. Required for automatic login; never printed.
RTD_PASS=""

# Registration number of the vehicle used for the exam.
# Required when preparing the calendar; the vehicle must suit the category.
RTD_PLATE_NUMBER=""

# Run mode: once checks availability and exits; watch repeats checks.
# Default: once. Override with npm start -- --mode once or --mode watch.
RTD_MODE=once

# Exam centre ID: 1 Nicosia, 2 Limassol, 3 Larnaca, 4 Paphos, 7 Deryneia.
# Default: 1. Each run checks this centre only, not all cities.
RTD_CENTRE=1

# Licence category exactly as offered by your RTD account.
# Default: BB. Latin BB also matches Greek ΒΒ; the category must be available.
RTD_CATEGORY=BB

# Earliest acceptable exam date, inclusive (YYYY-MM-DD).
# Required. Every week intersecting this date through RTD_DATE_TO is checked.
# A partial first week is OK: earlier days may be displayed in RTD but cannot
# match or pause monitoring. Calendar navigation supports +/-24 months.
RTD_DATE_FROM=2026-12-04

# Latest acceptable exam date, inclusive (YYYY-MM-DD).
# Required. Must be >= RTD_DATE_FROM.
# A range may span at most 366 days. Partial last weeks are filtered too.
RTD_DATE_TO=2026-12-31

# Earliest acceptable slot time, inclusive; 24-hour HH:MM in Cyprus time.
# Default: 07:00. Slots earlier than this cannot match or pause monitoring.
RTD_TIME_FROM=07:00

# Latest acceptable slot time, inclusive; 24-hour HH:MM in Cyprus time.
# Default: 18:00. Must be >= RTD_TIME_FROM; overnight windows are unsupported.
RTD_TIME_TO=18:00

# Seconds to wait after a completed watch cycle before starting the next one.
# Integer 60-3600; default: 120. A cycle may cover multiple weeks.
# Calendar HTTP 429 doubles this interval per failure, up to 3600 seconds;
# a longer Retry-After is respected. Success resets it. No fixed 15-minute wait.
# Network errors also increase the delay; paused manual booking has no timer.
RTD_INTERVAL_SECONDS=120

# Seconds to wait between weeks within a range scan (once or watch).
# Allowed: 1-30; default: 2. Requests run sequentially, never in parallel.
RTD_SCAN_DELAY_SECONDS=2

# true (default): in watch mode, stop at the first matching week and keep the
# browser open for manual booking. next/n skips it; restart/r scans from the
# start and clears skipped weeks; quit/q or Ctrl+C exits and closes the browser.
# false: keep scanning and only report matches. once always completes its scan.
RTD_PAUSE_ON_MATCH=true

# Playwright browser channel. Default: chrome, using installed Google Chrome.
# The app uses a separate local profile in .local/browser, not your main profile.
RTD_BROWSER_CHANNEL=chrome
